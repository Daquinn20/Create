//@version=6
// =====================================================================
// DCA MATRIX V6 — two validated entry paths + tranche scheduler
//
// CALM path : W%R exits oversold AND ATR% < its own 50-bar average
// PANIC path: W%R exits oversold AND volume > 1.5x its own 50-bar average
//
// Both validated out-of-sample on ~500 names across two universes,
// permutation-tested. Requiring BOTH tested as NOT real — they are
// alternative paths, not a combined condition.
//
// Edge concentrates at 12-26 bars. Both paths are NEGATIVE over the
// first ~4 bars, so the indicator schedules the buy in tranches rather
// than all at once.
// =====================================================================

indicator("DCA Matrix V6 — dual entry + tranches", shorttitle="DCA Matrix V6", overlay=false, precision=2)

gE = "1 · Shared entry condition"
wrLen    = input.int(14,    "Williams %R length", minval=2, group=gE)
wrDeep   = input.float(-85, "Deep zone: W%R was at or below", group=gE)
wrExit   = input.float(-80, "Breakout: W%R crosses above", group=gE)
wrDeepLB = input.int(20,    "Bars to look back for deep reading", minval=1, group=gE)
minGap   = input.int(5,     "Min bars between signals", minval=0, group=gE)
warmup   = input.int(80,    "Warm-up bars", minval=0, group=gE)

gA = "2 · CALM path — ATR contraction"
useCalm   = input.bool(true, "Enable CALM path", group=gA)
atrLen    = input.int(14, "ATR length", minval=2, group=gA)
atrBase   = input.int(50, "ATR baseline window", minval=10, group=gA)
atrThresh = input.float(1.00, "ATR% below this x its average", minval=0.5, maxval=2.0, step=0.05, group=gA)

gB = "3 · PANIC path — volume climax"
usePanic   = input.bool(true, "Enable PANIC path", group=gB)
volBase    = input.int(50, "Volume baseline window", minval=10, group=gB)
climaxMult = input.float(1.50, "Volume above this x its average", minval=1.0, maxval=4.0, step=0.10, group=gB)

gT = "4 · Tranche scheduler"
useTranche  = input.bool(true, "Split the buy into tranches", group=gT)
nTranches   = input.int(4, "Number of tranches", minval=1, maxval=8, group=gT)
trancheGap  = input.int(1, "Bars between tranches", minval=1, group=gT)
baseAmount  = input.float(4000, "Total intended purchase ($)", minval=0, group=gT)

gV = "5 · Display"
showPanel   = input.bool(true, "Show dashboard", group=gV)
panelPos    = input.string("Top Right", "Dashboard position", options=["Top Left","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Right"], group=gV)
showRejects = input.bool(true, "Mark filtered-out breakouts", group=gV)
showRatios  = input.bool(true, "Plot both ratio lines", group=gV)
f_pos(s) => s == "Top Left" ? position.top_left : s == "Top Right" ? position.top_right : s == "Middle Left" ? position.middle_left : s == "Middle Right" ? position.middle_right : s == "Bottom Left" ? position.bottom_left : position.bottom_right

cCalm   = #00E6E6
cPanic  = #FF8C00
cGrid   = #787B86
cDim    = #4A4A4A

// ---------------------------------------------------------------------
wr = ta.wpr(wrLen)

atrP     = ta.rma(ta.tr(true), atrLen) / close
atrAvg   = ta.sma(atrP, atrBase)
atrRatio = atrAvg > 0 and not na(atrAvg) ? atrP / atrAvg : na
contracting = not na(atrRatio) and atrRatio < atrThresh

volAvg   = ta.sma(volume, volBase)
volRatio = volAvg > 0 and not na(volAvg) ? volume / volAvg : na
climax   = not na(volRatio) and volRatio > climaxMult

wasDeep    = ta.lowest(wr, wrDeepLB) <= wrDeep
wrBreakout = ta.crossover(wr, wrExit) and wasDeep
warmedUp   = bar_index >= math.max(warmup, math.max(atrBase, volBase) + wrDeepLB)

var int lastSig = -100000
gapOK = (bar_index - lastSig) > minGap

calmRaw  = warmedUp and wrBreakout and useCalm  and contracting and gapOK
panicRaw = warmedUp and wrBreakout and usePanic and climax      and gapOK

buySignal = calmRaw or panicRaw
isCalm    = calmRaw
isPanic   = panicRaw and not calmRaw

// ---------------------------------------------------------------------
// Tranche scheduler: on a signal, schedule N buys spaced trancheGap bars
// apart. The h4-negative pattern means a lump buy at the signal is worse
// than averaging in over the first few bars.
// ---------------------------------------------------------------------
var int   trancheStart = -100000
var int   tranchesDone = 0
var bool  lastWasPanic = false

if buySignal
    lastSig      := bar_index
    trancheStart := bar_index
    tranchesDone := 0
    lastWasPanic := isPanic

sinceStart  = bar_index - trancheStart
inWindow    = useTranche and trancheStart > -100000 and tranchesDone < nTranches
trancheDue  = inWindow and sinceStart >= 0 and (sinceStart % trancheGap == 0)
if trancheDue
    tranchesDone += 1

trancheSize = nTranches > 0 ? baseAmount / nTranches : baseAmount
windowOpen  = useTranche and tranchesDone > 0 and tranchesDone < nTranches

var int nCalm  = 0
var int nPanic = 0
var int nBreak = 0
if warmedUp and wrBreakout
    nBreak += 1
if calmRaw
    nCalm += 1
if isPanic
    nPanic += 1

// PANIC follow-up: fire 4 bars after each PANIC signal so the review point is on the chart
var int lastPanicBar = -100000
if isPanic
    lastPanicBar := bar_index
panicFollowup = lastPanicBar > -100000 and (bar_index - lastPanicBar) == 4

// ---------------------------------------------------------------------
plot(showRatios ? atrRatio : na, "ATR ratio", color=contracting ? cCalm : color.new(cCalm, 65), linewidth=2)
plot(showRatios ? volRatio : na, "Volume ratio", color=climax ? cPanic : color.new(cPanic, 65), linewidth=1)
plot(showRatios ? atrThresh : na, "ATR threshold", color=color.new(cCalm, 55), style=plot.style_circles)
plot(showRatios ? climaxMult : na, "Climax threshold", color=color.new(cPanic, 55), style=plot.style_circles)
hline(1.0, "Average", color=color.new(cGrid, 40), linestyle=hline.style_dashed)

bgcolor(windowOpen ? color.new(lastWasPanic ? cPanic : cCalm, 92) : na, title="Accumulation window")

plotshape(showRejects and warmedUp and wrBreakout and not buySignal, "Breakout filtered out", shape.circle, location.bottom, color.new(cDim, 30), size=size.tiny)
plotshape(isCalm,  "CALM buy",  shape.triangleup, location.bottom, cCalm,  size=size.small, text="CALM")
plotshape(isPanic, "PANIC buy", shape.triangleup, location.bottom, cPanic, size=size.small, text="PANIC")
plotshape(trancheDue and not buySignal, "Tranche due", shape.diamond, location.bottom, color.new(color.white, 25), size=size.tiny)
plotshape(panicFollowup, "PANIC +4w review", shape.flag, location.bottom, cPanic, size=size.tiny, text="+4w")

var table tp = table.new(f_pos(panelPos), 2, 7, border_width=1, frame_width=1, frame_color=cGrid)
hdr = #17365D

if showPanel and barstate.islast
    table.cell(tp, 0, 0, "DCA MATRIX V6", text_color=color.white, bgcolor=hdr, text_size=size.tiny)
    table.cell(tp, 1, 0, str.tostring(nCalm) + " calm / " + str.tostring(nPanic) + " panic / " + str.tostring(nBreak), text_color=color.white, bgcolor=hdr, text_size=size.tiny)

    table.cell(tp, 0, 1, "W%R", text_size=size.tiny)
    table.cell(tp, 1, 1, str.tostring(wr, "#.#") + (wr <= wrDeep ? "  OVERSOLD" : ""), text_color=color.black, bgcolor=wr <= wrDeep ? cPanic : color.new(cGrid, 65), text_size=size.tiny)

    table.cell(tp, 0, 2, "ATR ratio", text_size=size.tiny)
    table.cell(tp, 1, 2, na(atrRatio) ? "-" : str.tostring(atrRatio, "#.00") + (contracting ? "  CALM ok" : "  expanding"), text_color=color.black, bgcolor=contracting ? cCalm : color.new(cGrid, 65), text_size=size.tiny)

    table.cell(tp, 0, 3, "Volume ratio", text_size=size.tiny)
    table.cell(tp, 1, 3, na(volRatio) ? "-" : str.tostring(volRatio, "#.00") + (climax ? "  PANIC ok" : ""), text_color=color.black, bgcolor=climax ? cPanic : color.new(cGrid, 65), text_size=size.tiny)

    table.cell(tp, 0, 4, "Tranche", text_size=size.tiny)
    table.cell(tp, 1, 4, trancheStart < -1000 ? "none" : str.tostring(tranchesDone) + " of " + str.tostring(nTranches) + (windowOpen ? "  OPEN" : "  done"), text_color=color.black, bgcolor=windowOpen ? color.new(color.white, 30) : color.new(cGrid, 65), text_size=size.tiny)

    table.cell(tp, 0, 5, "Per tranche", text_size=size.tiny)
    table.cell(tp, 1, 5, "$" + str.tostring(trancheSize, "#"), text_size=size.tiny)

    table.cell(tp, 0, 6, "Last signal", text_size=size.tiny)
    table.cell(tp, 1, 6, lastSig < -1000 ? "none on chart" : str.tostring(bar_index - lastSig) + " bars ago (" + (lastWasPanic ? "panic" : "calm") + ")", text_size=size.tiny)

alertcondition(isCalm,     "CALM buy — quiet base",     "{{ticker}}: W%R exited oversold with volatility contracting")
alertcondition(isPanic,    "PANIC buy — volume climax", "{{ticker}}: W%R exited oversold on climax volume")
alertcondition(buySignal,  "Any BUY signal",            "{{ticker}}: DCA Matrix entry signal — begin tranche 1")
alertcondition(trancheDue and not buySignal, "Tranche due", "{{ticker}}: next tranche due")
alertcondition(panicFollowup, "PANIC +4 weeks", "{{ticker}}: PANIC signal fired 4 weeks ago - review for follow-through")
